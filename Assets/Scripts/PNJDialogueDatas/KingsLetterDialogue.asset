  rows:
  - characterName: Lettre du Roi
    longDialogue: "Bien le bonjour cher aventurier. Nous vous avons invoqu\xE9 afin
      que vous sauviez notre royaume."
    NextRowNumber: 1
    characterImage: {fileID: 0}
  - characterName: Lettre du Roi
    longDialogue: "Pour commencer votre p\xE9riple, vous devrez affronter la sentinelle
      qui se trouve au nord du territoire, non loin de l\xE0."
    NextRowNumber: 2
    characterImage: {fileID: 0}
  - characterName: Lettre du Roi
    longDialogue: "Si vous r\xE9ussissez \xE0 la vaincre alors le passage pour la
      plaine sera de nouveau ouverte et nous pourrons nous rendre au ch\xE2teau."
    NextRowNumber: 3
    characterImage: {fileID: 0}
  - characterName: Lettre du Roi
    longDialogue: "Si vous avez des questions, venez me retrouver \xE0 la cit\xE9."
    NextRowNumber: -1
    characterImage: {fileID: 0}
